{
  "name": "mily-english-abhyas",
  "version": "1.0.0",
  "private": true,
  "description": "Class IV English practice-paper site for Mily (Atomic Energy Education Society, 2025-26).",
  "scripts": {
    "validate": "node validate.js",
    "test:validator": "node scripts/test-validator.js",
    "test:similarity": "python3 scripts/test_similarity.py",
    "test:readability": "python3 scripts/test_readability.py",
    "similarity": "python3 scripts/similarity.py",
    "readability": "python3 scripts/readability.py",
    "check": "npm run validate && python3 scripts/similarity.py",
    "build": "node build.js",
    "test:build": "node scripts/test-build.js",
    "serve": "node scripts/serve.js",
    "dev": "node build.js && node scripts/serve.js",
    "e2e": "node scripts/e2e.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "dependencies": {}
}
